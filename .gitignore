# =============================================================================
# IBM Interview Trainer Agent - .gitignore
# =============================================================================

# Environment & Secrets (NEVER commit these)
.env
.env.*
*.env

# Python Virtual Environment
.venv/
venv/
env/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Build / Distribution
build/
dist/
*.egg-info/
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Logs
logs/*.log
logs/audit.log
*.log

# Data & Vector Stores
data/vector_store/
*.db
*.sqlite3

# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Streamlit secrets
.streamlit/secrets.toml

# Temporary
tmp/
temp/
*.tmp
env.txt
